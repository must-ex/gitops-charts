{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["global", "datadogAgent"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["awsRegion"],
      "properties": {
        "awsRegion": { "type": "string", "minLength": 1 },
        "esoRoleArn": { "type": "string" }
      }
    },
    "datadogAgent": {
      "type": "object",
      "required": ["site", "clusterName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "site": { "type": "string", "minLength": 1 },
        "clusterName": { "type": "string" },
        "env": { "type": "string" },
        "credentials": {
          "type": "object",
          "required": ["apiSecretName", "apiSecretKey"],
          "properties": {
            "apiSecretName": { "type": "string", "minLength": 1 },
            "apiSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "scopedNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "clusterCheckConfigs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "logCollection": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "containerCollectAll": { "type": "boolean" },
            "processingRules": {
              "type": "array",
              "description": "Rendered as DD_LOGS_CONFIG_PROCESSING_RULES — agent-global exclude_at_match/mask_sequences rules, evaluated before logs leave the node.",
              "items": { "type": "object" }
            }
          }
        },
        "apm": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "targets": {
              "type": "array",
              "description": "Rendered as features.apm.instrumentation.targets on the CR — per-namespace tracer config (Single Step Instrumentation), e.g. DD_DBM_PROPAGATION_MODE for DBM<->APM correlation.",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "namespaceSelector": { "type": "object" },
                  "ddTraceConfigs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "value"],
                      "properties": {
                        "name": { "type": "string", "minLength": 1 },
                        "value": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "refreshInterval": { "type": "string" },
        "secretStoreName": { "type": "string" },
        "targetSecretName": { "type": "string" },
        "remoteRef": {
          "type": "object",
          "properties": {
            "key": { "type": "string" },
            "property": { "type": "string" }
          }
        }
      }
    },
    "secretStore": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" }
      }
    }
  }
}
