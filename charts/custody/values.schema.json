{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["esoSecretName", "awsRegion"],
      "properties": {
        "ecrRegistry":       { "type": "string" },
        "esoSecretName":     { "type": "string", "minLength": 1 },
        "esoRoleArn":        { "type": "string" },
        "awsRegion":         { "type": "string", "minLength": 1 },
        "domain":            { "type": "string" },
        "acmCertificateArn": { "type": "string" },
        "environment":       { "type": "string", "description": "Unified Service Tagging `env` value (dev/staging/prod)" }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "resources"],
        "properties": {
          "enabled":      { "type": "boolean" },
          "replicaCount": { "type": "integer", "minimum": 0 },
          "strategy": {
            "type": "object",
            "description": "Deployment rollout strategy. Omit for the Kubernetes default (RollingUpdate 25%/25%). Set {type: Recreate} for singleton schedulers such as celery beat, where a rolling update runs two schedulers concurrently.",
            "properties": {
              "type":          { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
              "rollingUpdate": {
                "type": "object",
                "properties": {
                  "maxSurge":       { "type": ["integer", "string"] },
                  "maxUnavailable": { "type": ["integer", "string"] }
                }
              }
            }
          },
          "containerPort": { "type": "integer" },
          "reloader":     { "type": "boolean" },
          "unifiedServiceTagging": { "type": "boolean", "description": "When true, adds tags.datadoghq.com/{env,service,version} labels and DD_ENV/DD_SERVICE/DD_VERSION env vars" },
          "apmInstrumentation": { "type": "boolean", "description": "When true, adds the admission.datadoghq.com/enabled=true pod label so the Datadog Admission Controller auto-injects the tracer library (no image rebuild)" },
          "image": {
            "type": "object",
            "required": ["repository", "tag"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "tag":        { "type": "string", "minLength": 1 }
            }
          },
          "resources": {
            "type": "object",
            "required": ["requests", "limits"],
            "properties": {
              "requests": {
                "type": "object",
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu":    { "type": "string" },
                  "memory": { "type": "string" }
                }
              },
              "limits": {
                "type": "object",
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu":    { "type": "string" },
                  "memory": { "type": "string" }
                }
              }
            }
          },
          "service": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "port":    { "type": "integer" },
              "type":    { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
            }
          },
          "hpa": {
            "type": "object",
            "properties": {
              "enabled":                        { "type": "boolean" },
              "minReplicas":                    { "type": "integer", "minimum": 1 },
              "maxReplicas":                    { "type": "integer", "minimum": 1 },
              "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
          },
          "serviceAccount": {
            "type": "object",
            "properties": {
              "create":      { "type": "boolean" },
              "name":        { "type": "string" },
              "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        }
      }
    },
    "additionalExternalSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "awsSecretName", "targetSecretName"],
        "properties": {
          "name":             { "type": "string", "minLength": 1 },
          "awsSecretName":    { "type": "string", "minLength": 1 },
          "targetSecretName": { "type": "string", "minLength": 1 },
          "refreshInterval":  { "type": "string" },
          "secretStoreName":  { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
